# 数据库连接（按需修改）
DATABASE_URL="mysql://root:root@localhost:3306/shangmeng"

# 服务
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=*
TZ=Asia/Shanghai

# JWT（S1 接入鉴权时使用）
JWT_SECRET=shangmeng-dev-secret
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# 内部服务 / 定时任务 / SSE 订阅静态令牌
# SSE：GET /api/v1/sse/notifications?token=dev-api-token
API_TOKEN=dev-api-token

# SSE 心跳间隔（毫秒），需小于 Nginx proxy_read_timeout
SSE_HEARTBEAT_MS=30000
