# =============================================================================
# web 前端环境变量模板（复制为 .env.development / .env.production 使用）
# =============================================================================

# S1.4 起 Mock 已整体移除（src/mock/** 删除），此变量仅为兼容保留，任何取值都不生效
VITE_USE_MOCK=false

# 接口基础路径：浏览器 → Nginx → /api/v1 → server
VITE_API_BASE=/api/v1

# 仅本地 `npm run dev` 生效的代理目标：默认走网关 Nginx（localhost:80），
# 与生产链路一致，避免 dev/prod 行为偏差
VITE_PROXY_TARGET=http://localhost:80
