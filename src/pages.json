{
  // 微信原生 tabBar 的 list 最多 5 项，会员 4 项与商家 4 项不能放进同一份配置。
  // 两套底部菜单在 components/AppTabBar.vue 里按 bootstrap 返回的 role / tabs 切换。
  "pages": [
    {
      "path": "pages/login/index",
      "style": { "navigationBarTitleText": "登录" }
    },
    {
      "path": "pages/member/home/index",
      "style": { "navigationBarTitleText": "会员码", "enableShareAppMessage": true, "enableShareTimeline": true, "enablePullDownRefresh": true, "backgroundTextStyle": "dark" }
    },
    {
      "path": "pages/member/wallet/index",
      "style": { "navigationBarTitleText": "卡包", "enableShareAppMessage": true, "enableShareTimeline": true }
    },
    {
      "path": "pages/member/mall/index",
      "style": { "navigationBarTitleText": "积分商城" }
    },
    {
      "path": "pages/member/mine/index",
      "style": { "navigationBarTitleText": "我的" }
    },
    {
      "path": "pages/member/profile/index",
      "style": { "navigationBarTitleText": "我的" }
    },
    {
      "path": "pages/member/galaxy/index",
      "style": {
        "navigationBarTitleText": "周围联盟",
        "navigationBarBackgroundColor": "#f3f7f8",
        "navigationBarTextStyle": "black",
        "backgroundColor": "#f3f7f8",
        "enablePullDownRefresh": true,
        "backgroundTextStyle": "dark"
      }
    },
    {
      "path": "pages/member/points/index",
      "style": { "navigationBarTitleText": "积分明细", "enablePullDownRefresh": true, "backgroundTextStyle": "dark" }
    },
    {
      "path": "pages/member/qrcode/index",
      "style": { "navigationBarTitleText": "我的会员码" }
    },
    {
      "path": "pages/apply/index",
      "style": { "navigationBarTitleText": "入驻申请", "enableShareAppMessage": true }
    }
  ],
  "subPackages": [
    {
      "root": "pages/merchant",
      "pages": [
        {
          "path": "workbench/index",
          "style": { "navigationBarTitleText": "首页", "enableShareAppMessage": true, "enablePullDownRefresh": true, "backgroundTextStyle": "dark" }
        },
        { "path": "verify/index", "style": { "navigationBarTitleText": "核销" } },
        { "path": "earn/index", "style": { "navigationBarTitleText": "录单发积分", "enablePullDownRefresh": true, "backgroundTextStyle": "dark" } },
        { "path": "redeem/index", "style": { "navigationBarTitleText": "核销" } },
        { "path": "notice/index", "style": { "navigationBarTitleText": "通知" } },
        { "path": "mine/index", "style": { "navigationBarTitleText": "我的" } },
        { "path": "staff/index", "style": { "navigationBarTitleText": "店员与权限", "enableShareAppMessage": true } },
        { "path": "marketing/index", "style": { "navigationBarTitleText": "营销与卡券", "enablePullDownRefresh": true, "backgroundTextStyle": "dark" } },
        { "path": "issue/index", "style": { "navigationBarTitleText": "发放代金券" } }
      ]
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "小Z",
    "navigationBarBackgroundColor": "#f3f7f8",
    "backgroundColor": "#f3f7f8",
    "onReachBottomDistance": 80
  }
}
