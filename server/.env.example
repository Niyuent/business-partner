# =============================================================================
# server 环境变量（本地开发读取 .env；容器环境由 docker-compose 注入）
# =============================================================================

# ---------------------------------------------------------------- 数据库
# 本地开发（docker compose 只起 mysql 时）：
DATABASE_URL="mysql://shangmeng:shangmeng@localhost:3306/shangmeng"
# 容器内：
# DATABASE_URL="mysql://shangmeng:shangmeng@mysql:3306/shangmeng"

# ---------------------------------------------------------------- 服务
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ---------------------------------------------------------------- 鉴权
JWT_SECRET=please-change-jwt-secret-at-least-32-chars
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# 静态令牌：仅用于「外部系统对接」
#   POST /api/v1/sse/publish、GET /api/v1/sse/stats、POST /api/v1/auth/dev-token（临时调试）
# 后台用户 SSE 不使用它：JWT → POST /sse/ticket → GET /sse/notifications?ticket=
API_TOKEN=please-change-api-token

# ---------------------------------------------------------------- SSE
# 心跳间隔（毫秒），必须小于 Nginx proxy_read_timeout（默认配置 3600s）
SSE_HEARTBEAT_MS=30000
# 一次性 ticket 有效期（毫秒）
SSE_TICKET_TTL_MS=60000

# ---------------------------------------------------------------- 其他
CORS_ORIGIN=*
TZ=Asia/Shanghai

# ---------------------------------------------------------------- AI（经营日报）
# 容器里由 docker-compose 注入 http://laya:8765；本地 nest 直连映射端口。
LAYA_SERVICE_URL=http://127.0.0.1:8765
# 与小Z经营助手 config/env.py 相同的三个变量。不把密钥写进仓库。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DEEPSEEK_MODEL=deepseek-flash
