        { "path": "notice/index", "style": { "navigationBarTitleText": "通知" } },
        { "path": "mine/index", "style": { "navigationBarTitleText": "我的" } }
      ]
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "商盟",
    "navigationBarBackgroundColor": "#ffffff",
    "backgroundColor": "#f4f6f8"
