  // 两套底部菜单在 components/AppTabBar.vue 里按 bootstrap 返回的 role / tabs 切换。
  "pages": [
    {
      "path": "pages/login/index",
      "style": { "navigationBarTitleText": "登录" }
    },
    {
      "path": "pages/member/home/index",
      "style": { "navigationBarTitleText": "首页", "enableShareAppMessage": true, "enableShareTimeline": true }
    },
    {
      "path": "pages/member/wallet/index",
      "style": { "navigationBarTitleText": "卡包", "enableShareAppMessage": true, "enableShareTimeline": true }
    },
    {
      "path": "pages/member/mall/index",
      "style": { "navigationBarTitleText": "积分商城" }
    },
    {
      "path": "pages/member/mine/index",
      "style": { "navigationBarTitleText": "我的" }
    },
    {
      "path": "pages/member/profile/index",
      "style": { "navigationBarTitleText": "我的" }
    },
    {
      "path": "pages/member/points/index",
      "style": { "navigationBarTitleText": "积分明细" }
    },
    {
      "path": "pages/apply/index",
      "style": { "navigationBarTitleText": "入驻申请", "enableShareAppMessage": true }
