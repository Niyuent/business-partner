{
  "name": "shangmeng-system",
  "version": "0.1.0",
  "private": true,
  "description": "代金券积分系统 · 网页端管理后台（主体商家 / 附属商家）",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev:server": "npm run start:dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w server && npm run build -w web",
    "prisma:generate": "npm run prisma:generate -w server",
    "prisma:migrate": "npm run prisma:migrate -w server",
    "prisma:seed": "npm run prisma:seed -w server",
    "prisma:studio": "npm run prisma:studio -w server",
    "db:reset": "docker compose exec -T server npm run prisma:seed",
    "regression": "node scripts/regression.mjs"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
