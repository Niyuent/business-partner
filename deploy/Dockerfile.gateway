# 商盟系统 · 网关镜像（Nginx + 前端静态资源，自包含，不依赖共享卷）
# 构建上下文为仓库根目录：
#   docker build -f deploy/Dockerfile.gateway --build-arg VITE_USE_MOCK=false -t shangmeng-gateway:latest .
#
# 说明：这里直接多阶段构建前端产物并 COPY 进镜像，
#      避免共享卷带来的权限/残留/启动顺序问题。

# ------------------------------------------------------------------ 前端构建
FROM node:22-alpine AS web-builder
WORKDIR /app

COPY package.json package-lock.json ./
COPY web ./web
COPY server/package.json ./server/

RUN npm config set registry https://registry.npmmirror.com
RUN npm ci

ARG VITE_USE_MOCK=false
ARG VITE_API_BASE=/api/v1
ENV VITE_USE_MOCK=$VITE_USE_MOCK \
    VITE_API_BASE=$VITE_API_BASE

RUN npm run build -w web

# ------------------------------------------------------------------ 网关
FROM nginx:1.27-alpine

COPY --from=web-builder /app/web/dist /usr/share/nginx/html
COPY deploy/nginx/gateway.conf /etc/nginx/conf.d/default.conf

# nginx 官方镜像以 nginx 用户运行 worker，确保可读可写
RUN chown -R nginx:nginx /usr/share/nginx/html /var/log/nginx 2>/dev/null || true

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
