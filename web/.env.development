# =============================================================================
# web(screen) 前端环境变量（Vite 构建期注入，运行时不可变）
# =============================================================================

# S1.4 起前端 Mock 已彻底关闭（src/mock/** 已删除，request.ts 不再挂载 adapter）
# 保留变量仅为兼容历史写法；任何取值都不会触发 Mock，所有请求一律打到真实后端
VITE_USE_MOCK=false

# 接口基础路径：浏览器 → Nginx → /api/v1 → NestJS
VITE_API_BASE=/api/v1

# 本地 dev server 的代理目标。
# server 容器未把 3000 端口暴露给宿主机，统一走网关 Nginx（localhost:80）反代，
# 与生产链路完全一致，避免「dev 能跑 prod 不行」的偏差。
VITE_PROXY_TARGET=http://localhost:80
