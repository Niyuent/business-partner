# =============================================================================
# 商盟系统 · 生产环境变量（docker compose 读取）
# 复制为 .env 后按需修改：cp .env.example .env
# ⚠️ 修改所有 *_PASSWORD / SECRET / TOKEN 后再部署
# =============================================================================

# ---------------------------------------------------------------- 通用
TZ=Asia/Shanghai
# 镜像标签
TAG=latest

# ---------------------------------------------------------------- MySQL
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=please-change-root-password
MYSQL_DATABASE=shangmeng
MYSQL_USER=shangmeng
MYSQL_PASSWORD=please-change-password

# ---------------------------------------------------------------- 后端 server
# 容器内通过服务名访问：mysql:3306
DATABASE_URL=mysql://shangmeng:please-change-password@mysql:3306/shangmeng
SERVER_PORT=3000
# NODE_ENV=production 时自动关闭 Swagger（/api/docs）；本地开发填 development
NODE_ENV=development
API_PREFIX=api/v1

# JWT（S1 鉴权启用后必须修改）
JWT_SECRET=please-change-jwt-secret-at-least-32-chars
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# 静态令牌：仅用于「外部系统对接」（POST /api/v1/sse/publish、GET /sse/stats、临时调试令牌）
# ⚠️ 不用于后台用户 SSE：后台走 JWT → /sse/ticket → /sse/notifications?ticket=
API_TOKEN=please-change-api-token

# CORS：生产建议填具体域名，多个用逗号分隔
CORS_ORIGIN=*

# SSE 心跳间隔（毫秒），需小于 Nginx proxy_read_timeout
SSE_HEARTBEAT_MS=30000
# SSE 一次性 ticket 有效期（毫秒），默认 60 秒
SSE_TICKET_TTL_MS=60000

# ---------------------------------------------------------------- 微信登录（S5.1）
# WX_MODE：real（默认，生产必须）| mock（仅本地开发：NODE_ENV!=production 且仅回环/内网 IP 生效）
WX_MODE=real
# real 模式必须填写，否则后端启动即报错（code2session 需要）
WX_APPID=
WX_SECRET=

# ---------------------------------------------------------------- 前端 screen（构建期 ARG）
# 生产必须为 false：走真实后端
VITE_USE_MOCK=false
# 前端请求基础路径（浏览器 → Nginx → /api/v1 → server）
VITE_API_BASE=/api/v1
# 仅本地 dev 直连后端时使用
VITE_PROXY_TARGET=http://server:3000

# ---------------------------------------------------------------- 网关 Nginx
NGINX_PORT=80
# 前端独立镜像（screen，默认不启动）暴露端口
SCREEN_PORT=8080
